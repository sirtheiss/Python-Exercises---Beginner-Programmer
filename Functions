elif ex == 105:
    def grades(*numbers, sit=False):
        """
        :param numbers: Variable amount of grades
        :return: dictionary with statistics
        """
        result = {}

        result['total'] = len(numbers)
        result['highest'] = max(numbers)
        result['lowest'] = min(numbers)
        result['average'] = sum(numbers) / len(numbers)
        if sit:
            if result['average'] > 7:
                result['situation'] = 'GOOD'
            else:
                result['situation'] = 'BAD'

        return result


    stats = grades(9.0, 2.5, 10.0, sit=True)

    print(f"There were {stats['total']} grades.")
    print(f"The best grade was {stats['highest']}")
    print(f"The worst grade was {stats['lowest']}")
    print(f"The average grade was {stats['average']:.2f}")
    print(f"The class situation was {stats['situation']}")

