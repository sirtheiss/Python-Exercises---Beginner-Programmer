elif ex == 102:
    def factorial(num, show=False):
        """
        :param num: Number to calculate the factorial
        :param show: True/False to show the calculating process
        :return: Returns the result of the factorial
        """
        result = 1

        for i in range(num, 0, -1):
            result *= i
            if show:
                print(i, end=' x ' if i > 1 else ' = ')

        return result


    num = int(input('What factorial do you want? '))
    show = input('Show the calculating process? [y/n]: ').lower() == 'y'

    print(factorial(num, show))

