elif ex == 74:
    numbers = (randint(0,10), randint(0,10), randint(0,10), randint(0,10),
               randint(0,10))
    smallestnumber = numbers[0]
    largestnumber = numbers[0]
    print(f'The sorted numbers were: ', end='')
    for n in numbers:
        print(f'{n} ', end='')
        if n < smallestnumber:
            smallestnumber = n
        if n > largestnumber:
            largestnumber = n
    print(f'\nThe smallest number is {smallestnumber},'
          f' the largest number is {largestnumber}.')


elif ex == 75:
