    n3 = int(input('Type in an integer number: '))
    n4 = int(input('Type in an integer number: '))
    numbers = (n1, n2, n3, n4)
    print(f'There were {numbers.count(9)} number nines typed')
    evens = []
    if 3 in numbers:
        print(f'The first number three was typed in position {numbers.index(3)+1}')
    else:
        print('There were no number threes typed')
    for n in numbers:
        if n % 2 == 0:
            evens.append(n)
    print(f'The even numbers are: {evens}')

